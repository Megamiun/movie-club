# Copy to terraform.tfvars (gitignored) and fill in real values. Never commit the real file.
#
# No secrets here -- jwt_secret/database_password/tmdb_access_token/omdb_api_key are set directly in SSM
# Parameter Store by hand (see infra/README.md's bootstrap step), not through Terraform, so their plaintext never
# passes through a .tfvars file, a GitHub secret, or Terraform state.

domain_name          = "example.com"      # must already be an existing Route53 hosted zone
ssh_public_key       = "ssh-ed25519 AAAA..." # contents of e.g. ~/.ssh/id_ed25519.pub
ssh_allowed_cidr     = "1.2.3.4/32"       # your own IP -- never 0.0.0.0/0
github_repository    = "your-org/movie-club" # scopes which repo/branch can assume the GitHub Actions deploy role
tf_state_bucket_name = "movie-club-terraform-state" # must match backend.hcl's own bucket -- see versions.tf

# GitHub's OIDC sub claim is immutable for repos created after 2026-07-15 and always embeds these two numeric
# ids -- find them via `gh api users/<owner> --jq .id` and `gh api repos/<owner>/<repo> --jq .id`. See
# variables.tf's comment for why this can't just be the plain "owner/repo" name.
github_owner_id = "12345678"
github_repo_id  = "123456789"
