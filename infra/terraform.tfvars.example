# Copy to terraform.tfvars (gitignored) and fill in real values. Never commit the real file -- it holds secrets.

domain_name       = "example.com"      # must already be an existing Route53 hosted zone
ssh_public_key    = "ssh-ed25519 AAAA..." # contents of e.g. ~/.ssh/id_ed25519.pub
ssh_allowed_cidr  = "1.2.3.4/32"       # your own IP -- never 0.0.0.0/0
github_repository = "your-org/movie-club" # scopes which repo/branch can assume the GitHub Actions deploy role

jwt_secret         = "generate-a-long-random-value-here"
database_password  = "generate-a-long-random-value-here"
tmdb_access_token  = "your-tmdb-api-read-access-token"
omdb_api_key       = ""              # optional -- IMDB ratings are best-effort and no-op without one
