### 0. Login (uses docs/dummy-user.sql seeded admin@example.com)
POST http://localhost:8080/auth/login
Content-Type: application/json

{ "email": "admin@example.com", "password": "hunter2" }

> {%
  client.global.set("jwt", response.body.token);
%}

### 1. Create a club to work in
POST http://localhost:8080/clubs
Authorization: Bearer {{jwt}}
Content-Type: application/json

{ "name": "Series Test Club" }

> {%
  client.global.set("clubId", response.body.id);
%}

### 2. Search series in TMDB catalog
GET http://localhost:8080/series/search?q=Breaking+Bad
Authorization: Bearer {{jwt}}

### 3. Add a series by IMDB id (TMDB TV fetch populates everything else)
POST http://localhost:8080/clubs/{{clubId}}/series
Authorization: Bearer {{jwt}}
Content-Type: application/json

{ "imdbUrlOrId": "tt0903747" }

> {%
  client.global.set("seriesId", response.body.id);
%}

### 4. List series for the club
GET http://localhost:8080/clubs/{{clubId}}/series
Authorization: Bearer {{jwt}}

### 5. Import all seasons and episodes for a series automatically from TMDB
POST http://localhost:8080/series/{{seriesId}}/import-seasons
Authorization: Bearer {{jwt}}

### 6. Add season 1 manually
POST http://localhost:8080/series/{{seriesId}}/seasons
Authorization: Bearer {{jwt}}
Content-Type: application/json

{ "number": 1, "title": "Season 1" }

> {%
  client.global.set("seasonId", response.body.id);
%}

### 7. Create a meeting to schedule an episode against
POST http://localhost:8080/clubs/{{clubId}}/meetings
Authorization: Bearer {{jwt}}
Content-Type: application/json

{ "date": "2026-06-06" }

> {%
  client.global.set("meetingId", response.body.id);
%}

### 8. Add episode 1, scheduled to the meeting
POST http://localhost:8080/seasons/{{seasonId}}/episodes
Authorization: Bearer {{jwt}}
Content-Type: application/json

{ "number": 1, "title": "Pilot", "meetingId": "{{meetingId}}" }

> {%
  client.global.set("episodeId", response.body.id);
%}

### 9. Add episode 2, unscheduled (no meeting yet)
POST http://localhost:8080/seasons/{{seasonId}}/episodes
Authorization: Bearer {{jwt}}
Content-Type: application/json

{ "number": 2, "title": "Cat's in the Bag..." }

### 10. Search club episodes
GET http://localhost:8080/clubs/{{clubId}}/episodes/search?q=Pilot
Authorization: Bearer {{jwt}}

### 11. Get next suggested episodes for scheduling
GET http://localhost:8080/clubs/{{clubId}}/episodes/next-suggestions
Authorization: Bearer {{jwt}}

### 12. List episodes scheduled for the meeting
GET http://localhost:8080/meetings/{{meetingId}}/episodes
Authorization: Bearer {{jwt}}

### 13. Schedule episode 2 to the same meeting too
POST http://localhost:8080/episodes/{{episodeId}}/meetings/{{meetingId}}
Authorization: Bearer {{jwt}}

### 14. Unassign it again
DELETE http://localhost:8080/episodes/{{episodeId}}/meetings/{{meetingId}}
Authorization: Bearer {{jwt}}

### 15. Get rating scale option ids
GET http://localhost:8080/clubs/{{clubId}}/rating-scales
Authorization: Bearer {{jwt}}

> {%
  client.global.set("qualityOptionId", response.body[0].options[1].id);
%}

### 16. Rate at series, season, and episode level independently
PUT http://localhost:8080/series/{{seriesId}}/review
Authorization: Bearer {{jwt}}
Content-Type: application/json

{ "qualityOptionId": "{{qualityOptionId}}" }

###
PUT http://localhost:8080/seasons/{{seasonId}}/review
Authorization: Bearer {{jwt}}
Content-Type: application/json

{ "comment": "great season" }

###
PUT http://localhost:8080/episodes/{{episodeId}}/review
Authorization: Bearer {{jwt}}
Content-Type: application/json

{ "qualityOptionId": "{{qualityOptionId}}", "comment": "great pilot" }

### 17. Refresh TMDB metadata
POST http://localhost:8080/series/{{seriesId}}/refresh-metadata
Authorization: Bearer {{jwt}}
