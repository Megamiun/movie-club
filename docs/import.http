[{"choiceInitial":"G","csvDisplayName":"Gabryel","memberId":"{{gabryelId}}"},{"choiceInitial":"C","csvDisplayName":"Camila","memberId":"{{camilaId}}"}]
--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="reserve.csv"
