# Copy this file to .env and fill in the values.
# The DATABASE_* defaults below match `docker compose up db` out of the box.

DATABASE_URL=jdbc:postgresql://localhost:5432/movieclub
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

JWT_SECRET=change-me-in-production

TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=movie-club-posters
