# Copy this file to .env and fill in the values.
# The DATABASE_* defaults below match `docker compose up db` out of the box.

DATABASE_URL=jdbc:postgresql://localhost:5432/movieclub
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

JWT_SECRET=change-me-in-production

TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# https://www.omdbapi.com/apikey.aspx -- free tier. Used to fetch IMDB's own rating (TMDB's API doesn't expose it).
OMDB_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=movie-club-posters

# Both optional, local dev only -- `docker compose up -d minio` runs a local S3-compatible store for member photo
# uploads (see CLAUDE.md's Member section). Leave both unset for a real deployment against real AWS S3.
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY above default to "minioadmin" (docker-compose.yml) when running against
# MinIO, so they can stay blank here too unless you've changed MinIO's own root credentials.
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000

# Baked into the frontend build — must be reachable from the browser, not just
# from inside the compose network, so it stays http://localhost:8080 by default.
VITE_API_BASE_URL=http://localhost:8080
